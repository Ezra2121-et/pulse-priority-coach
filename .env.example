# Browser-safe Supabase project configuration
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-side Supabase configuration (where server/admin operations are used)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Keep this key server-only; never prefix it with VITE_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: enables AI task-prioritization suggestions
LOVABLE_API_KEY=""
